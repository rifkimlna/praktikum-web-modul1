# Copy ke .env dan isi dengan connection string Postgres kamu
# Contoh Vercel Postgres / Neon:
# DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require"
# DIRECT_URL="postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require"

DATABASE_URL="postgresql://user:password@localhost:5432/praktikum?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/praktikum?schema=public"

# Variabel bawaan Vercel Postgres (opsional, auto-inject saat link Storage di Vercel):
# POSTGRES_URL=""
# POSTGRES_PRISMA_URL=""
# POSTGRES_URL_NON_POOLING=""
